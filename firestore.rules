rules_version = '2';

// BLACKBOX security rules.
// Only verified accounts get in. A project is visible to its members and to people invited by email.
// Invited people can only add themselves (accept) or remove their invitation (decline).
// Roles per project: owner (ownerId), admin, member (default), viewer (read and chat).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isMember(data) {
      return signedIn() && request.auth.uid in data.memberIds;
    }
    function isInvited(data) {
      return signedIn() && myEmail() in data.invitedEmails;
    }
    function roleOf(data) {
      return request.auth.uid == data.ownerId ? 'owner' : data.get('roles', {}).get(request.auth.uid, 'member');
    }
    function canEdit(data) {
      return isMember(data) && roleOf(data) in ['owner', 'admin', 'member'];
    }
    function isAdmin(data) {
      return isMember(data) && roleOf(data) in ['owner', 'admin'];
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function acceptsInvite() {
      return onlyChanged(['memberIds', 'members', 'invitedEmails'])
        && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
        && request.resource.data.invitedEmails.toSet() == resource.data.invitedEmails.toSet().difference([myEmail()].toSet())
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);
    }
    function declinesInvite() {
      return onlyChanged(['invitedEmails'])
        && request.resource.data.invitedEmails.toSet() == resource.data.invitedEmails.toSet().difference([myEmail()].toSet());
    }
    function validMemberUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.ownerId == before.ownerId
        && before.ownerId in after.memberIds
        // Only the owner adds or removes other people and edits their member entries;
        // anyone else can only leave and update their own entry.
        && (request.auth.uid == before.ownerId
            || (after.memberIds.toSet().hasAll(before.memberIds.toSet().difference([request.auth.uid].toSet()))
                && after.memberIds.toSet().difference(before.memberIds.toSet()).size() == 0
                && after.members.diff(before.members).affectedKeys().hasOnly([request.auth.uid])));
    }
    // Which project fields each role may change.
    function fieldsAllowed() {
      let role = roleOf(resource.data);
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return role == 'owner'
        || (role == 'admin' && !(request.resource.data.get('roles', {}).values().hasAny(['owner'])))
        || (role == 'member' && keys.hasOnly(['collections', 'release', 'assetFolders', 'members', 'memberIds']))
        || (role == 'viewer' && keys.hasOnly(['members', 'memberIds']));
    }

    // Profiles (photo, name, role, contact email) are visible to signed-in people; each person edits their own.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /projects/{projectId} {
      function project() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      allow read: if isMember(resource.data) || isInvited(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update: if (isMember(resource.data) && validMemberUpdate() && fieldsAllowed())
        || (isInvited(resource.data) && (acceptsInvite() || declinesInvite()));
      allow delete: if isMember(resource.data) && resource.data.ownerId == request.auth.uid;

      // Tasks, collection items and assets: members create and edit; members delete their own, admins anything.
      match /tasks/{taskId} {
        allow read: if isMember(project());
        allow create, update: if canEdit(project());
        allow delete: if isAdmin(project()) || (canEdit(project()) && resource.data.get('createdBy', '') == request.auth.uid);
      }
      match /items/{itemId} {
        allow read: if isMember(project());
        allow create, update: if canEdit(project());
        allow delete: if isAdmin(project()) || (canEdit(project()) && resource.data.get('createdBy', '') == request.auth.uid);
      }
      match /assets/{assetId} {
        allow read: if isMember(project());
        allow create, update: if canEdit(project());
        allow delete: if isAdmin(project()) || (canEdit(project()) && resource.data.get('uid', '') == request.auth.uid);
      }
      // Patch notes: everyone reads, admins write.
      match /updates/{updateId} {
        allow read: if isMember(project());
        allow write: if isAdmin(project());
      }
      match /activity/{entryId} {
        allow read: if isMember(project());
        // The log can't be erased by the people it records; only the owner (deleting the project) removes it.
        allow delete: if isMember(project()) && project().ownerId == request.auth.uid;
        allow create: if isMember(project()) && request.resource.data.uid == request.auth.uid;
      }
      // Chat: everyone in the project (viewers too) writes; authors edit, authors and admins delete.
      match /messages/{messageId} {
        allow read: if isMember(project());
        allow create: if isMember(project()) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember(project()) && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember(project())
          && (resource.data.uid == request.auth.uid || isAdmin(project()));
      }
      match /channels/{channelId}/messages/{messageId} {
        allow read: if isMember(project());
        allow create: if isMember(project()) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember(project()) && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember(project())
          && (resource.data.uid == request.auth.uid || isAdmin(project()));
      }
      // Notifications: a member writes one to another member; only the recipient reads it or marks it
      // read. The owner can remove them when deleting the project.
      match /notifications/{notifId} {
        allow create: if isMember(project())
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in project().memberIds
          && request.resource.data.read == false;
        // The owner also lists them, to remove them when deleting the project.
        allow read: if signedIn() && (resource.data.to == request.auth.uid || project().ownerId == request.auth.uid);
        allow update: if signedIn() && resource.data.to == request.auth.uid && onlyChanged(['read']);
        allow delete: if signedIn() && (resource.data.to == request.auth.uid || project().ownerId == request.auth.uid);
      }
    }
  }
}
